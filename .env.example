APP_ENV=local
APP_NAME=shekel-backend
LOG_LEVEL=INFO

KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=shekel-backend
KAFKA_GROUP_ID=shekel-app

DATABASE_URL=postgresql+asyncpg://shekel:shekel@localhost:5432/shekel
OUTBOX_POLL_INTERVAL_SECONDS=1

REDIS_URL=redis://localhost:6379/0
SESSION_SECRET=change-me-local
SESSION_COOKIE_NAME=shekel_session
SESSION_TTL_SECONDS=604800

KEYCLOAK_ISSUER=memory://
KEYCLOAK_AUDIENCE=shekel-api
KEYCLOAK_REALM=shekel
KEYCLOAK_TEST_SECRET=change-me-oidc-test-at-least-32-bytes
KEYCLOAK_ADMIN_URL=http://localhost:8080
KEYCLOAK_ADMIN_CLIENT_ID=shekel-api
KEYCLOAK_ADMIN_CLIENT_SECRET=
ELASTICSEARCH_URL=memory://

HTTP_TIMEOUT_SECONDS=5
HTTP_MAX_RETRIES=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30
