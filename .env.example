APP_ENV=local
APP_NAME=nickel-backend
LOG_LEVEL=INFO

KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=nickel-backend
KAFKA_GROUP_ID=nickel-app

DATABASE_URL=postgresql+asyncpg://nickel:nickel@localhost:5432/nickel
OUTBOX_POLL_INTERVAL_SECONDS=1

REDIS_URL=redis://localhost:6379/0
SESSION_SECRET=change-me-local
SESSION_COOKIE_NAME=nickel_session
SESSION_TTL_SECONDS=604800

KEYCLOAK_ISSUER=memory://
KEYCLOAK_AUDIENCE=nickel-api
KEYCLOAK_REALM=nickel
KEYCLOAK_TEST_SECRET=change-me-oidc-test-at-least-32-bytes
KEYCLOAK_ADMIN_URL=http://localhost:8080
KEYCLOAK_ADMIN_CLIENT_ID=nickel-api
KEYCLOAK_ADMIN_CLIENT_SECRET=
ELASTICSEARCH_URL=memory://

HTTP_TIMEOUT_SECONDS=5
HTTP_MAX_RETRIES=3
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30
